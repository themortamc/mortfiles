{
    "layer": "top",
    "position": "top",
    "margin-top": 5,
    "margin-left": 10,
    "margin-right": 10,
    "height": 30,
    "spacing": 4,
    "modules-left": ["custom/player-prev", "mpris", "custom/player-next", "tray"],
    "modules-center": ["clock"],
    "modules-right": ["custom/weather", "custom/ping", "cpu", "memory", "pulseaudio"],

